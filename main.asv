% KbWait();
% sca();


%% enterinng the main loop

rng('shuffle');


while state ~= 10
    disp(state)
    
    if state == 0
        trial = 0;
        next_state = 1;
    elseif state == 1
        trial = trial + 1; 

        % fixation
        Screen('DrawDots', w_ptr,WINDOW_CENTER, FIXATION_CIRCLE_RADIUS, [0, 0, 255], [], 2 );
        Screen('Flip', w_ptr);
        WaitSecs(FIXATION_TIME);
        next_state = 2;
    elseif state == 2
        % fixation dissappear 
        Screen('Flip', w_ptr);
        WaitSecs(FIXATION_DISAPPEAR_TIME);
        

        % object selection
        [] = select_fractals()
        
       

        next_state = 3;

    elseif state == 3 
        %object selection

    elseif state == 4
        % display off

    elseif state == 5
        % NO PRESS 


    elseif state == 6
        % REJECT PRESS TA


    elseif state == 7
        % REJECT PRESS TP


    elseif state == 8
        % REWARD DELIVARY 


    elseif state == 9
        % ending
        break
    end
        



state = next_state;
end


KbWait();
sca();



%% functions
function [fractal_indexees, index_of_high_fractal] = select_fractals(fractals_avalable, fractal_values, to_have_high_value, number_of_fractals_to_show)
    fractals_without_high_value = fractal_values == 0;
    fractals_with_high_value = fractal_values == 1;

    fractal_indexees = randsample(fractals_avalable(fractals_without_high_value), number_of_fractals_to_show- to_have_high_value);
    index_of_high_fractal = randsample(fractals_avalable(fractals_with_high_value),  to_have_high_value);

end